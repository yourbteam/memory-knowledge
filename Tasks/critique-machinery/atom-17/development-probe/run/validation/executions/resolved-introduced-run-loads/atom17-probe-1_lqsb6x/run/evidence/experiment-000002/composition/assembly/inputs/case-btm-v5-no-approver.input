  "activation_cards": [
   {
    "name": "Public identity cleanup and claim register",
    "insight": "The Stop Line cannot build trust if public records carry conflicts or claims that do not point to proof.",
    "idea": "Clean buyer-facing public identity and create the claim register that records each AI claim, its proof type, senior owner and stated stop line.",
    "engagement_mechanic": "Internal reviewers inspect buyer-facing records before any claim is promoted and mark conflicts for closure.",
    "desired_outcome": "The B Team enters launch with a clean public base and a visible proof-before-promotion route.",
    "targets": "Month 1: Kamen Kamenov, Matthew Maday and the assigned public-identity owner read the claim register, public-profile conflict list and Key-Message Table before any Month 2 build work starts.",
    "hashtag_or_signature": "The Stop Line",
    "audience": "Owners of midsize businesses, technical buyers, referral partners and senior Sofia talent who will see the cleaned public identity later in the year.",
    "message_pillar": "Proof comes before promotion.",
    "peso_channel": "Owned",
    "phase": "Pre-Seed",
    "hero_hub_hygiene": "Hygiene",
    "month": 1,
    "kpi": [
     {
      "metric": "public-profile conflicts closed",
      "scale": "count",
      "instrument": "public identity cleanup register"
     },
     {
      "metric": "AI claims carrying proof owner and stop-line fields",
      "scale": "percentage",
      "instrument": "The Stop Line claim register"
     }
    ]
   },
   {
    "name": "The Stop Line proof page",
    "insight": "Buyers do not need a bigger AI promise; they need to see what is proved, who owns it and where the system stops.",
    "idea": "Create the owned proof page for The Stop Line, live, unpromoted, until the Launch moment in Month 4, showing each approved claim with proof type, senior owner and stated limit.",
    "engagement_mechanic": "Visitors will be able to inspect proof behind a claim before they are asked to book a meeting or accept the AI story.",
    "desired_outcome": "The B Team has the proof base that paid, earned, shared and sales activity can all point to.",
    "targets": "Month 2: Kamen Kamenov, Matthew Maday, sales reviewers and selected partner reviewers read the unpromoted proof page and proof labels before Month 4 promotion.",
    "hashtag_or_signature": "The Stop Line",
