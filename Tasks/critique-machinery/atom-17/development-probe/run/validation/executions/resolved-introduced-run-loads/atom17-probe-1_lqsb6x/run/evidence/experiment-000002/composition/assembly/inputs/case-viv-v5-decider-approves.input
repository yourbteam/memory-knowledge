  "activation_cards": [
   {
    "name": "Proof Lock and Claim Boundary Room",
    "insight": "The Invisible Thread can only build trust if every reach, service and household claim stays inside named proof.",
    "idea": "Build the approved proof map for So You Can and The Invisible Thread before any public activity, with reach limited to OpenSignal coverage-experience proof and service friction treated as part of the promise.",
    "engagement_mechanic": "Legal and Regulatory Affairs reviews the Key-Message Table, do-not-say lines, proof notes and comparison language before internal teams use them.",
    "desired_outcome": "The year starts with a cleared language base that stops the platform becoming a broad network or size claim.",
    "targets": "Legal and Regulatory Affairs reads its claim-clearance register each week in Month 1 and confirms in writing before the Month 2 internal briefing which claims the team may use next.",
    "hashtag_or_signature": "So You Can / The Invisible Thread",
    "audience": "Legal and Regulatory Affairs, leaders, media-preparation contacts, regulators and parent-group stakeholders.",
    "message_pillar": "Reach is proved carefully, not claimed broadly.",
    "peso_channel": "Owned and internal, with earned lines prepared but not released.",
    "phase": "Pre-Seed",
    "hero_hub_hygiene": "Hygiene",
    "month": 1,
    "kpi": [
     {
      "metric": "priority platform claims with approved proof pair",
      "scale": "percentage",
      "instrument": "Month 1 Legal and Regulatory Affairs claim-clearance register"
     },
     {
      "metric": "do-not-say breaches found before publication",
      "scale": "count",
      "instrument": "pre-publish guardrail checklist"
     }
    ],
    "approver": "Maria Bengtsson"
   },
   {
    "name": "Conversation Management Loop",
    "insight": "Customers judge The Invisible Thread most sharply when service, billing, app payment or outage questions appear in public.",
    "idea": "Run the always-on listen, triage, respond and escalate loop under So You Can so service friction is answered as proof of the platform, not treated as a side issue.",
    "engagement_mechanic": "Daily monitoring routes live customer themes to approved service lines, escalation owners and owned-channel updates.",
    "desired_outcome": "Vivacom has a visible, disciplined answer when daily digital life is tested.",
    "targets": "Conversation themes, escalation decisions and response-line use are read daily from Month 1 through Month 12, with a weekly service-friction readout.",
    "hashtag_or_signature": "The Invisible Thread in service moments",
    "audience": "Existing customers, service teams, employees and leaders.",
    "message_pillar": "Every service moment is where The Invisible Thread is either proved or broken in public.",
