{
 "case_id": "case-viv-v5-decider-approves",
 "pack": {
  "phases": [
   {
    "phase": "Pre-Seed",
    "objective": "Lock the proof, claim boundaries, response lines and internal advocacy discipline before So You Can and The Invisible Thread become public.",
    "months": "1 · 2"
   },
   {
    "phase": "Launch",
    "objective": "Introduce So You Can through The Invisible Thread with an earned-led household story that starts with Maya and existing customers.",
    "months": "3 · 4"
   },
   {
    "phase": "Sustain",
