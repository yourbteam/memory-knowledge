ource_evidence_sha256","work_state"]}],"policy":{"command_effects":{"all":{"effect_identity":"parent effect id plus the deterministic seed-local, seed-host, push-kv, reseed-azure, and verify child effect ids","prepare":"Persist the complete ordered child graph and all resolved resource identities before the first mutation.","reconciliation":"Reconcile each child independently and continue only from the first NOT_APPLIED child; any INDETERMINATE child keeps the parent INDETERMINATE and prevents a duplicate write."},"mint":{"effect_class":"OPERATOR_INSTRUCTION","reconciliation":"Replay-safe; emits the fixed mint instructions and performs no credential read or mutation."},"push-kv":{"effect_identity":"resolved vault resource id plus fixed secret names plus source credential/config fingerprints","prepare":"Persist the vault resource id, fixed secret names, source fingerprints, and pre-write secret version ids before upload.","reconciliation":"Key Vault metadata tags bind each new version to effect_id and the non-secret source fingerprint. Matching enabled versions are ALREADY_APPLIED; unchanged pre-write versions are NOT_APPLIED; divergent or partially updated secret versions are INDETERMINATE."},"reseed-azure":{"effect_identity":"resolved deployment id plus authenticated reseed request id plus expected Key Vault version ids","prepare":"Persist deployment id, request id, and expected vault versions before the authenticated reseed call.","reconciliation":"Query the authenticated reseed/status surfaces. A receipt for request id followed by remote Claude status valid and a credential file version at least the expected vault version is ALREADY_APPLIED; explicit absence with the old remote version is NOT_APPLIED; timeout without queryable receipt or conflicting versions is INDETERMINATE."},"seed-host":{"effect_identity":"host credential provider slot plus source credential fingerprint plus operating-system target kind","prepare":"Persist the provider slot id, OS target kind, and non-secret source fingerprint before mutation.","reconciliation":"The provider compares the installed credential fingerprint and runs the bounded exact host AUTH_OK probe. Match plus pass is ALREADY_APPLIED; proved prior fingerprint is NOT_APPLIED; disagreement or an unreadable post-write slot is INDETERMINATE."},"seed-local":{"effect_identity":"resolved container id plus fixed credential path plus source credential fingerprint plus optional config fingerprint","prepare":"Persist the resolved container identity and non-secret source fingerprints before any copy.","reconciliation":"Hash the installed credential/config inside the same container and run the bounded exact AUTH_OK probe. Matching fingerprints and a passing probe are ALREADY_APPLIED; proved old fingerprints are NOT_APPLIED; a replaced container, partial fingerprint match, or conflicting target is INDETERMINATE."},"status":{"effect_class":"OBSERVATION","reconciliation":"Replay the typed local, host, and vault status probes; absence is an explicit observed state, never a skipped success."},"verify":{"effect_class":"OBSERVATION","reconciliation":"Replay every selected bounded probe and retain its typed result; no selected target may be silently skipped."}},"dry_run_rule":"dry_run=true performs no credential read or mutation and terminalizes only as DRY_RUN, never APPLIED.","secret_rule":"Credential contents never enter argv, logs, journal events, terminal artifacts, or error text. The owner may retain only a non-secret content SHA-256 and provider/resource version identifiers."},"policy_sha256":"8fc463829f1d9931e35fc82ddb68678fe483d50d9248c9ddfc14b1c70056e330","required_clause_ids":["00fc3db8be885aeb4fc4da4d18b9028a45f364b67bafcf0dd667e5ce3e3bc522","0ece08d7f75eab210a57285f3793d944dc80712a4f2cc4748b44bab795c5cb9e","1bfeef992fd9a2eb22d46eb6100da6b46822895e0f84dbfe7b2566892f5e8a2d","2689102f1038a84edcb63a925d69c79ede0b3ad56987deab7cbe096588e9b175","3ede3fc0c3b9ef29ff4121411a105a07300eb2633de9a3b15fed5c58e