ource_evidence_sha256"],"result_fields":["identity","observed_at_utc","ownership","prestate","probes","receipt","source_evidence_sha256","work_state"]},{"maximum_age_seconds":300,"observable_id":"claude-auth-token-refresh/verify/reconciliation","ownership_fields":["effect_id","owner_sequence_id","preparation_artifact_sha256"],"profile":"verify","provider_symbol":"observe_claude_auth_token_refresh_verify_reconciliation","read_only":true,"request_fields":["effect_id","owner_sequence_id","preparation_artifact_sha256","observation_targets","prepared_prestate_identities","prepared_receipt_identities","profile","probe_ids","provider_symbol","source_evidence_sha256"],"result_fields":["identity","observed_at_utc","ownership","prestate","probes","receipt","source_evidence_sha256","work_state"]}],"policy":{"command_effects":{"all":{"effect_identity":"parent effect id plus the deterministic seed-local, seed-host, push-kv, reseed-azure, and verify child effect ids","prepare":"Persist the complete ordered child graph and all resolved resource identities before the first mutation.","reconciliation":"Reconcile each child independently and continue only from the first NOT_APPLIED child; any INDETERMINATE child keeps the parent INDETERMINATE and prevents a duplicate write."},"mint":{"effect_class":"OPERATOR_INSTRUCTION","reconciliation":"Replay-safe; emits the fixed mint instructions and performs no credential read or mutation."},"push-kv":{"effect_identity":"resolved vault resource id plus fixed secret names plus source credential/config fingerprints","prepare":"Persist the vault resource id, fixed secret names, source fingerprints, and pre-write secret version ids before upload.","reconciliation":"Key Vault metadata tags bind each new version to effect_id and the non-secret source fingerprint. Matching enabled versions are ALREADY_APPLIED; unchanged pre-write versions are NOT_APPLIED; divergent or partially updated secret versions are INDETERMINATE."},"reseed-azure":{"effect_identity":"resolved deployment id plus authenticated reseed request id plus expected Key Vault version ids","prepare":"Persist deployment id, request id, and expected vault versions before the authenticated reseed call.","reconciliation":"Query the authenticated reseed/status surfaces. A receipt for request id followed by remote Claude status valid and a credential file version at least the expected vault version is ALREADY_APPLIED; explicit absence with the old remote version is NOT_APPLIED; timeout without queryable receipt or conflicting versions is INDETERMINATE."},"seed-host":{"effect_identity":"host credential provider slot plus source credential fingerprint plus operating-system target kind","prepare":"Persist the provider slot id, OS target kind, and non-secret source fingerprint before mutation.","reconciliation":"The provider compares the installed credential fingerprint and runs the bounded exact host AUTH_OK probe. Match plus pass is ALREADY_APPLIED; proved prior fingerprint is NOT_APPLIED; disagreement or an unreadable post-write slot is INDETERMINATE."},"seed-local":{"effect_identity":"resolved container id plus fixed credential path plus source credential fingerprint plus optional config fingerprint","prepare":"Persist the resolved container identity and non-secret source fingerprints before any copy.","reconciliation":"Hash the installed credential/config inside the same container and run the bounded exact AUTH_OK probe. Matching fingerprints and a passing probe are ALREADY_APPLIED; proved old fingerprints are NOT_APPLIED; a replaced container, partial fingerprint match, or conflicting target is INDETERMINATE."},"status":{"effect_class":"OBSERVATION","reconciliation":"Replay the typed local, host, and vault status probes; absence is an explicit observed state, never a skipped success."},"verify":{"effect_class":"OBSERVATION","reconciliation":"Replay every selected bounded probe and retain its typed result; no selected target may be silently skipped."}},"dry_run_rule":"dry_run=true performs no credential read or mutation and terminalizes only as DRY_RUN, never APPLIED.","secret_rule":"Credential contents never enter argv, logs, journal events, terminal artifacts, or error text. The owner may retain only a non-secret content SHA-256 and provider/resource version identifiers."},"policy_sha256":"8fc463829f1d9931e35fc82ddb68678fe483d50d9248c9ddfc14b1c70056e330","required_clause_ids":["00fc3db8be885aeb4fc4da4d18b9028a45f364b67bafcf0dd667e5ce3e3bc522","0ece08d7f75eab210a57285f3793d944dc80712a4f2cc4748b44bab795c5cb9e","1bfeef992fd9a2eb22d46eb6100da6b46822895e0f84dbfe7b2566892f5e8a2d","2689102f1038a84edcb63a925d69c79ede0b3ad56987deab7cbe096588e9b175","3ede3fc0c3b9ef29ff4121411a105a07300eb2633de9a3b15fed5c58e9fbe2be","462c90796cb63b8d68ca48d3b3eec34b5dbd42efe5c37ad57895781cb4281f60","497cc4cfd8ef69c45f22a4d9ab5190c185d0531a0bdd5853e87ce947323f59e3","4b76d8c38eeb57e20bece2d6ec952fefc2bfadd96d78453c111e317d302da965","665917cf0e19376195c28065d0e4832de3cef03a119c5012e0eca7b5485255cb","6adc91ab0d4dad55f83d3171e105de4f7fc5918dcf97c98fc735c48cc0470bd7","75be367844cb13343135c682744c7f48b3b63d5ceda2984a74c1b4f30630b8ab","7d539dbf6e57eb597d346261fa30a55e5415801ca34d06dd17f765b8c9c29c18","855989f8775997d427fb62b9c140628a01beeacf700ae8ac67aeb15d4f8ce383","9ddbeb1f27fa7214587e8dbd6f193f869650ff6ab7e7a9ecb7113d97b3e0b733","9fdfe8cbdabc5f4923bb17b44d701dd2c60572b30ef4fc7ad89932591ce66789","b125792d0f60dd602448b0ce6e9403ad126bcd3caa9593fbb18f3c0404f37e3c","b6ca081104e76cb8518fa512aa9820455cd9a93a4742b64f1477c048076b54aa","cb664d7b0494644b23f0d7650c911b04ef5b1fcd50e96cd5c42e46bfe0351061","cbd90ef6d4559e28d88a6981ae2d529df022dab9e839fb02f59b50bee000c89e","d5db45e54bc6867a243f40c317033dad12914b4cafd3250e2d19bdfae08f581a","e1b24da3d06f00f9229a3017e2d6b2b53f05520fd0f2769007161601f3986799","ec539e071c50d842903d5b14bdade3a12db946ba4cfbe38fff54832022862fe6","efcebd1535fbce895bdfe0f5f6cb54ab1fd6fec0cd30e9de0219fd0617b36a05"]},"reconciliation_handler"