fact_sha256"],"profile":"resume-push","provider_symbol":"observe_commit_push_main_resume_push_terminal","read_only":true,"request_fields":["effect_id","owner_sequence_id","preparation_artifact_sha256","observation_targets","prepared_prestate_identities","prepared_receipt_identities","profile","probe_ids","provider_symbol","source_evidence_sha256"],"result_fields":["identity","observed_at_utc","ownership","prestate","probes","receipt","source_evidence_sha256","work_state"]}],"policy":{"common":["The process return code is zero.","The schema-valid terminal artifact has ok=true and names mode, effect_id, authorization receipt id when required, repository identity, branch, remote-url hash, manifests, source/commit/remote object ids, and observation codes.","The semantic verifier re-reads local and remote Git state after the operation.","Exactly one owner_terminal event and one matching terminal artifact exist for effect_id."],"mode_specific":{"dry-run":"Repository identity, branch, remote, source HEAD, empty index, manifest paths, and worktree change hashes match the report; no Git mutation occurred.","integrate-remote-and-resume":"The integrated effect-marked commit descends from the prepared remote head, preserves the authorized manifest-only delta, equals local and remote heads, and leaves no rebase/index state.","isolated-integrate-and-resume":"The effect-marked isolated commit equals remote head, contains only the authorized manifest/overlay delta, and the source repository snapshot is byte-identical to preparation.","isolated-reconcile-and-resume":"The effect-marked reconciled commit equals remote head, contains only the authorized scope, satisfies the approved three-way/overlay/ledger rules, regenerates the blocker view canonically, and leaves the source snapshot unchanged.","publish":"The exact effect-marked local commit has the approved parent, message, metadata policy, and manifest-only delta; local HEAD and remote branch head equal that commit; the index is empty; unrelated paths retain their prepared state.","resume-push":"The authorized effect commit remains local HEAD and equals remote branch head; no new local commit was created."},"source_corrections":["Replace free repository paths and remote names with trusted repository/remote registry keys and materialized manifest sets.","Require and atomically consume an exact publication-authorization receipt for every mutating mode; contract approval alone never authorizes publication.","Add a deterministic Prevention-Effect-ID commit trailer and journaled stage receipts so a crash after commit or push can be reconciled without duplication.","Split long integration modes into progressively reserved typed stages and terminalize only after local/remote/source semantic re-observation."]},"policy_sha256":"f87b043ac8ea0d1a82aba5461de9bc69527d267bb1590f7438b989a09a8555f8","required_clause_ids":["05834d24b1d86e574cfb2f1977455fefbf724365778f6bd5eb9c76c95984fd8e","05faa60d66b5a07f7b49d286bc31e6663249222b44a3fcebc444bebbed7edd79","29fa9eed3e945c0c222849a7f04256031951759ac07b5bb8bb11e5c0f5f9c307","2a7cf0a77a2084aacdf5471035d4e532b3aa18e8fc05ce8d94e89bc58ee0b9d5","2f3fa343b1ee07a6143a72c3cded59a819ccecf23434fec8840d80727e2f5d74","33855d03458218260d19b500e193017c2ed203996227ef92276bc125b6eb91d1","aa11c00af4df037cc75dd796c2eb31dcb9319942e3c404423d199906314a24cd","abbb693fb37730fd94817e898bd227506f93e534e6356ca014bf6b95c9471d41","e04f4b7f6cc0dd2d16502c1c67b84ec0244dca61f3b79063aec442d6bd05f470","faa7a313cc53e4b2b976c05dc5cece217b0efd1c4a11668bf96eb17a771dc393"],"result_kinds":["EXECUTED_RESULT","RECOVERED_RESULT"],"semantic_observation_fields":["effect_id","evidence","observed_at_utc","owner_sequence_id","preparation_artifact_sha256","provider_id","raw_result","result_kind","terminal_policy_sha256"]},"terminal_handler":"verify_commit_push_main","terminal_policy_sha256":"f87b043ac8ea0d1a82aba5461de9bc69527d267bb1590f7438b989a09a8555f8"},"sha256":"8de7ab306ed2b812e4d57a48cbbd1f4cb216d39d8cd