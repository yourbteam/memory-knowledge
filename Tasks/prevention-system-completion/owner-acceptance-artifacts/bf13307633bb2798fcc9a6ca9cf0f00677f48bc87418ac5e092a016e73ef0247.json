ild proofs/checkpoint, active index, and stable post-audit. Candidate-set arrival with no semantic decision change closes that attempt as superseded-by-next-attempt; changed existing disposition, non-retain arrival, target drift, or allowlist drift is INDETERMINATE and stops."},"validate":{"effect_class":"OBSERVATION","effect_identity":"manifest canonical hash plus current repository/candidate/registry hashes","reconciliation":"Replay complete schema, snapshot, disposition, target bundle, and approval checks; return typed validity without mutation."}},"policy_sha256":"d535ca33ab45c52ac9afb05f6a50121fff55a938845f97c12350954ffbe8a30c","required_clause_ids":["11f4df559105ce32c8f15f7f5d5fceeef46b580fd3fd7ada7b0e0d6608625b03","232d8d063bd34eabbb0c74249f2d921b2412aa5bdd80da7d7ec54de557fe065a","260338add766bde68fd01dd52ff89c11a8c6f3f7b5ffc37befe6e59499935fa9","26443ffc0656d8a1c27095f6b21934ab1497ce16533c1da57055c5f8adcd3d61","48acf238557a69113d8df0d64af72c51fbd99c760fdfe04125b768805afb20dd","4b87a38b27635162d563e34d3e1a0c0fe3ca03bc99b3ce6f374a362bd7d8756a","55f710d9ee203f491eb7dd5fe7644b5b410de5a5da6dcf2caeb71bdcce3dd3f9","5c2319a4739722ab7540131145a003aa9c47811d425d06e27ff1cfbdd6416f87","6989e6672fa7c46896cfdaf483e0377197c522402b2d8e78bbf577535a768e93","a2da6ecc1b3e6740a797951b9adc4355000bb774efed29b816bd8957debb9660","a81025916bbc6c78394971dd6432eb21c4cff9eb5235d36e3ef31720048ddf1a","ab2aedc7a6e006aaa1a6391e22c11ab3561e1abe45f07202be1c331ba7f045ea","b5e5556dcd8a44a0b1aaf2e96ab7b0087ee41443112c25f97573951526fcfc06","de23b7fd394f6eebb432717fa9d9aa8f186a4cfd3577a3d0a3dbec6112bf5bf2","ee912a61757ba8aa71bb273877540652bd05ff87618671021a6b1e2093106931","ef4df0305c22cce1ca0f707ba91e31c3b2d98d92274f7b6f31659fa4ae7b2edd","ef69e1c9aa8569108b3c9eba1703c38ec069e800a5d95f2863d0ffe8a1675eba","f8426768f84d5b689dea9ded4578d0d64b32b89293769b821d1acc622ac029b0"]},"reconciliation_handler":"reconcile_discovery_candidate_reconciliation","resolved_parameters":{"active_index":"/Users/kamenkamen