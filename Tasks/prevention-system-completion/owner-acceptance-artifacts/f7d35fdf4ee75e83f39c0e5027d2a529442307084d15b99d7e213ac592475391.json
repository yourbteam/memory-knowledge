:"resume-push","provider_symbol":"observe_commit_push_main_resume_push_reconciliation","read_only":true,"request_fields":["effect_id","owner_sequence_id","preparation_artifact_sha256","observation_targets","prepared_prestate_identities","prepared_receipt_identities","profile","probe_ids","provider_symbol","source_evidence_sha256"],"result_fields":["identity","observed_at_utc","ownership","prestate","probes","receipt","source_evidence_sha256","work_state"]}],"policy":{"dry-run":{"effect_class":"OBSERVATION","effect_identity":"repository identity plus branch plus remote-url hash plus source HEAD plus manifest and worktree-content hashes","reconciliation":"Replay the exact preflight; return a typed eligibility report and perform no staging, commit, fetch, rebase, or push."},"integrate-remote-and-resume":{"effect_identity":"authorization receipt id plus original effect commit plus fetched remote head plus merge base plus manifest hash","prepare":"Persist the fetched remote head, merge base, authorized scope, original commit identity, and pre-rebase repository snapshot before rebase.","reconciliation":"Use Git rebase state plus effect trailer, parent lineage, exact manifest delta, and remote head. A completed exact integrated commit is ALREADY_APPLIED; fully restored original state is NOT_APPLIED; partial/conflicting rebase or scope drift is INDETERMINATE and must fail closed."},"isolated-integrate-and-resume":{"effect_identity":"authorization receipt id plus source commit/state hash plus fetched remote head plus manifest/overlay/message hashes","prepare":"Persist source snapshot, remote snapshot, deterministic isolated commit metadata, and temporary-workspace identity before cloning.","reconciliation":"Query the remote for the exact effect trailer and authorized tree delta. A matching remote head with unchanged source is ALREADY_APPLIED; unchanged remote/source with no effect commit is NOT_APPLIED; remote advance, conflicting effect marker, or changed source is INDETERMINATE."},"isolated-reconcile-and-resume":{"effect_identity":"authorization receipt id plus source commit/state hash plus fetched remote head/merge base plus manifest/overlay hashes plus canonical ledger event-id set hash","prepare":"Persist source and remote snapshots, approved semantic paths, canonical ledger identities, and deterministic isolated commit metadata before reconciliation.","reconciliation":"Require the exact effect-marked remote commit, authorized tree delta, canonical ledger union, regenerated blocker view, and byte-identical source snapshot for ALREADY_APPLIED. Unchanged remote/source with no effect commit is NOT_APPLIED; any semantic, remote, or source disagreement is INDETERMINATE."},"publish":{"effect_identity":"authorization receipt id plus repository identity plus initial HEAD plus branch plus remote-url hash plus manifest/content hash plus approved message hash","local_reconciliation":"If HEAD is the prepared initial HEAD and the index is empty, the local mutation is NOT_APPLIED. If HEAD is one direct child carrying the exact Prevention-Effect-ID trailer, approved message, parent, author/committer policy, and manifest-only tree delta, it is ALREADY_APPLIED_LOCAL. Any other HEAD/index/scope state is INDETERMINATE.","prepare":"Persist all identity fields, source/index/worktree snapshots, deterministic effect trailer, and authorization consumption before git add.","remote_reconciliation":"Resolve the remote branch head. Exact equality to the identified local effect commit is ALREADY_APPLIED_REMOTE; the prepared prior remote head with local effect commit retained is NOT_APPLIED_REMOTE; remote advance, missing effect commit, or conflicting effect marker is INDETERMINATE."},"resume-push":{"effect_identity":"authorization receipt id plus repository identity plus exact effect-marked HEAD commit plus branch and remote-url hash","reconciliation":"Require the exact prepared effect commit at HEAD, empty index, and unchanged authorized identities; reconcile the remote branch exactly as publish without creating another commit."},"resume_rule":"Continue only the first NOT_APPLIED stage. Never create a second effect-marked commit or push after ALREADY_APPLIED_REMOTE; every INDETERMINATE state stops without force push, reset, stash, or destructive cleanup."},"policy_sha256":"95edd938cf67b136f9f53b867b75bc2885b8b34d4cd70df5f744fdbc6de980bd","required_clause_ids":["0b4eb0a53a40c81b72ba12dcbc5ba2d53be621e38cfd027c38af37451be9b3ae","114b13e8debabeca08090402de2c65e76900e0a76666d30d2cdfbb8a2b0ba0fd","2c6e885e38e92566f0e8e873c833d4258afb72ed347c39d4177950b4d2a3dd8f","3c6b313dac92b752a2a5707a3643b26c084e1da13f3caa02f3ecc5230d524962","3d4f4395ba7eafdccb4ad0bedb905dc5c314d05908a73bd1ae6335dec784b40a","4153fff46752ceaf96ad3bda030d72d5795d6b6ffe4bec7c857e4da29b3d724b","41e6ac97daff8cef82187fb57f283270816c921f9e0ddc0ebda5c9247a70caad","50dc325f18e235cee169e032d5e49d12bd2b82a8cddb42a252d31c795069b7e8","72ba3599b08148049091d84a8e07d97b9fbce50b4f68e16aaf788efb4e891a96","7398490d9f2aa643996f532ce76d0e5a3291835332a5f05802a6fb3619c52d15","7816b75757c88cd63cbd5d60a01baf5d970e3631f98f1753f7f479fee869d0d3","78cd05dc6b1de13ed3ff405a65b5ef5731a86b41ea0b5a4fc9686280a8d2e92a","7b50dbceca141566fd43058fe61a123646689c28d966dfbcee9c588df0077b2e","7d9b66ada049b776a5945301b8700124340bf913ddf1a2188d13b379be11e2e4","80cae272822f0c23849bffa10ad23a7db82d0811e29d7aa71a4cdb16785b7f17","8ba87f5172454be8917147d9e0c0df75103c89fd638d5c41c0323bd37366a5c8","9fce2ab9ba1a8102921d59fd92488b5e8f73bc7b440d921240d52a654eb4bed3","f53a6a03b6aa76e0ef2fcc4bb48c7ae3fd1b42429176856d1744aee47c726199","fbb3910289c6964e69d0901870335c6cb993e71c531daa39ec8f06917d7af4c9"]},"reconciliation_handler":"reconcile_commit_push_main","resolved_parameters":{"authorization_receipt_id":"229d345b-97cd-5209-bf4d-7a50930e24ec","branch":"main","mode":"resume-push","remote_key":"acceptance-resource","repository_key":"acceptance-resource","resume_commit":"901295e25f72b26e5689f429455200c189d05482"},