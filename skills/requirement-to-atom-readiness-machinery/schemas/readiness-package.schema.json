{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_state": {
      "enum": [
        "not-approved",
        "approved",
        "rejected"
      ]
    },
    "atom_sequence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "controller_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ledger_prefix_tip": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^(?!manifest\\.json$)(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size",
          "sha256",
          "schema_version"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "predecessor_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "readiness": {
      "enum": [
        "blocked",
        "needs_owner",
        "ready"
      ]
    },
    "run_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_sha256",
    "input_sha256",
    "controller_sha256",
    "ledger_prefix_tip",
    "predecessor_manifest_sha256",
    "readiness",
    "approval_state",
    "atom_sequence_sha256",
    "members"
  ],
  "type": "object"
}
